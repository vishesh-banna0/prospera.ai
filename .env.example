# Backend environment configuration for Prospera
# Copy this file to `.env` and adjust values. Every setting below has a safe
# default in code, so the backend also runs with NO .env at all (offline, on a
# local SQLite database). Only add what you want to override.

# Application
APP_NAME=Prospera
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# Database
# Default (offline, zero setup): a local SQLite file.
DATABASE_URL=sqlite+aiosqlite:///./prospera.db
# For PostgreSQL instead, use something like:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/prospera
# Create missing tables automatically on startup (great for SQLite/local dev;
# set to false in production and apply the SQL migrations instead).
DB_AUTO_CREATE=true

# Cache (reserved for future use; not required to run)
REDIS_URL=redis://localhost:6379/0

# Market data provider (Finnhub live quotes + yfinance history).
# Leave the key blank to run offline — market-data/news endpoints will simply
# report they need a key, everything else still works.
MARKET_DATA_PROVIDER=finnhub
MARKET_DATA_API_KEY=
# Optional comma-separated backup keys used when the primary is rate-limited.
MARKET_DATA_API_KEYS=
MARKET_DATA_BASE_URL=https://finnhub.io/api/v1

# Currency / FX
# Prospera shows every value to the user in one base currency (INR) and stores
# transactions in INR. Foreign prices (e.g. AAPL in USD) are converted to INR.
BASE_CURRENCY=INR
# Fetch a real-time rate from yfinance ({CUR}INR=X); falls back to the static
# rates below if offline. Set to false to always use the static rates.
FX_LIVE=true
FX_CACHE_TTL_SECONDS=3600
FX_USD_INR=83.0
FX_EUR_INR=90.0
FX_GBP_INR=105.0

# Hosted LLM (used by the LLM-backed adapters: event extraction, reasoning, and
# research embeddings). Prospera NEVER downloads model weights — it calls an
# OpenAI-compatible endpoint. Point this at your existing local Ollama (default
# below) or any hosted gateway.
#
# ON by default: when a model is reachable it is used; when it is not (nothing
# listening on LLM_BASE_URL), the adapters fall back to their deterministic,
# offline implementations automatically and fast. Set LLM_ENABLED=false to force
# the deterministic path everywhere.
LLM_ENABLED=true
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1
# Embedding model for research retrieval (e.g. `ollama pull nomic-embed-text`).
# Falls back to the deterministic hashing embedder if unavailable.
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=30
# Short connect timeout so an unreachable endpoint fails over quickly.
LLM_CONNECT_TIMEOUT_SECONDS=3

# AI Advisor multi-agent models (each agent can use a different local model).
# Any model not installed just falls back to deterministic logic for that agent.
ADVISOR_ANALYST_MODEL=qwen2.5:7b
ADVISOR_STRATEGIST_MODEL=llama3:8b
ADVISOR_WRITER_MODEL=qwen2.5:7b

# Authentication (simple username/password)
# Passwords are stored only as PBKDF2-SHA256 hashes; login returns a signed token.
# A dev default is used if unset, so it runs out of the box — set a strong,
# random AUTH_SECRET_KEY for anything beyond local use (changing it logs everyone
# out, since existing tokens no longer verify). AUTH_TOKEN_TTL_HOURS = how long a
# login stays valid (default 168 = 7 days).
AUTH_SECRET_KEY=dev-insecure-change-me
AUTH_TOKEN_TTL_HOURS=168

# News auto-sync (background scheduler)
# The news warehouse is pull-then-store. With this on, the backend refreshes it
# on a timer so the UI is always current — no manual sync needed. Needs a
# market-data (Finnhub) key above; without one it's skipped. Set to false to
# only refresh news manually (POST /news/sync).
NEWS_AUTO_SYNC_ENABLED=true
NEWS_SYNC_INTERVAL_MINUTES=30
# "global" also feeds india/sector via classification. Add "company" only if you
# also configure symbols to fetch.
NEWS_SYNC_CATEGORIES=global
NEWS_SYNC_LIMIT=50

# Logging
LOG_LEVEL=INFO
