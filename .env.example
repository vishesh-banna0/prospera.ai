# Backend environment configuration for Prospera
# Copy this file to `.env` and replace placeholder values before running the backend.

# Application
APP_NAME=Prospera
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/prospera

# Cache
REDIS_URL=redis://localhost:6379/0

# Market data provider
MARKET_DATA_PROVIDER=finnhub
MARKET_DATA_API_KEY=replace_with_real_api_key
MARKET_DATA_BASE_URL=https://finnhub.io/api/v1

# Logging
LOG_LEVEL=INFO
